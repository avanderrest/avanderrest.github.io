{
  "name": "avanderrest-github-io",
  "version": "1.0.0",
  "private": true,
  "description": "The project wall — a static site, with dev-only tooling.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "python -m http.server 8010",
    "test": "node test/run.js",
    "shots": "node test/run.js --shots",
    "wall": "node tools/build-wall.js",
    "wall:check": "node tools/build-wall.js --check",
    "shoot": "node tools/shoot.js",
    "profiles": "node tools/profiles.js",
    "art": "python tools/pixel-art.py",
    "proto": "python tools/prototype.py",
    "proto:new": "node tools/proto/new.js",
    "proto:check": "node tools/proto/check.js",
    "people": "node tools/shoot.js neon-dark/people.html test/_shots/people.png --size 1400x900 --wait 600"
  }
}
